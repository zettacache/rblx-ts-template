{
  "name": "roblox-ts-template",
  "version": "1.0.0",
  "description": "Reusable Roblox TypeScript starter with Jecs and Flamework networking.",
  "private": true,
  "scripts": {
    "build": "rbxtsc",
    "watch": "rbxtsc -w",
    "serve": "node scripts/tool.mjs rojo serve default.project.json",
    "dev": "concurrently --kill-others --names compiler,rojo --prefix-colors cyan,magenta \"npm:watch\" \"npm:serve\"",
    "build:place": "npm run build && node scripts/build-place.mjs",
    "build:test": "npm run build && node scripts/build-place.mjs --test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "check": "npm run format:check && npm run lint && npm run build",
    "clean": "node scripts/clean.mjs",
    "doctor": "node scripts/doctor.mjs",
    "init:project": "node scripts/init-project.mjs",
    "test": "npm run build:test && node scripts/tool.mjs lune run tests/run.luau build/tests.rbxl",
    "test:tooling": "node --test scripts/tests/*.test.mjs && npm run test:pipelines",
    "test:studio": "node scripts/studio-smoke.mjs",
    "blender": "node scripts/blender.cjs",
    "blender:batch": "node scripts/blender-batch.cjs",
    "blender:doctor": "node scripts/blender.cjs doctor",
    "test:blender": "node scripts/test-blender-reuse.mjs",
    "studio": "node scripts/studio.cjs",
    "studio:doctor": "node scripts/studio.cjs doctor",
    "studio:sources": "node scripts/studio-sources.cjs",
    "studio:author": "node scripts/studio-author.cjs",
    "studio:queue": "node scripts/studio-reservation.cjs",
    "studio:turn": "node scripts/studio-turn.cjs",
    "studio:play": "node scripts/studio-play.cjs",
    "studio:scenario": "node scripts/studio-scenario.cjs",
    "studio:animation": "node scripts/studio-animation.cjs",
    "studio:assets": "node scripts/studio-assets.cjs",
    "studio:mesh": "node scripts/studio-mesh-assets.cjs",
    "test:pipelines": "node scripts/test-pipelines.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/testez": "0.4.2-ts.0",
    "@rbxts/types": "1.0.961",
    "@typescript-eslint/parser": "8.72.1",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-plugin-roblox-ts": "1.4.1",
    "prettier": "3.9.10",
    "rbxts-transformer-flamework": "1.3.2",
    "roblox-ts": "3.0.0",
    "typescript": "5.5.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@flamework/core": "1.3.2",
    "@flamework/networking": "1.3.2",
    "@rbxts/jecs": "0.11.0",
    "@rbxts/react": "17.3.13-ts.1",
    "@rbxts/react-roblox": "17.3.13-ts.1"
  }
}
