{
  "name": "roblox-ts-template",
  "globIgnorePaths": [
    "**/package.json",
    "**/tsconfig.json",
    "**/*.spec.luau",
    "**/*.spec.lua",
    "**/testez/**"
  ],
  "tree": {
    "$className": "DataModel",
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": { "ScreenOrientation": "Sensor" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "TS": {
        "$path": "out/server"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          },
          "@rbxts-js": {
            "$path": "node_modules/@rbxts-js"
          },
          "@flamework": {
            "$path": "node_modules/@flamework"
          }
        }
      },
      "TS": {
        "$path": "out/shared"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "TS": {
          "$path": "out/client"
        }
      }
    }
  }
}
